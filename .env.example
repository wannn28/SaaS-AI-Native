# Copy to .env for local npm development and for Docker Compose interpolation.
# These values are placeholders. Do not put real secrets in git.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Postgres (local npm). Compose overrides DATABASE_URL for the app container.
DATABASE_URL=postgresql://saas:saas@localhost:5432/saas
POSTGRES_USER=saas
POSTGRES_PASSWORD=saas
POSTGRES_DB=saas

# Clerk — https://dashboard.clerk.com
# Format-valid placeholder only. Replace with the key from the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZXhhbXBsZS1hcHAtMS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Stripe — https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_replace_me

# AI — OpenAI key used by the Vercel AI SDK provider
OPENAI_API_KEY=sk-replace_me
AI_MODEL=gpt-4o-mini
AI_QUOTA_FREE_TOKENS=50000
AI_QUOTA_PRO_TOKENS=2000000

# Optional Cloudflare R2 (S3-compatible presigned uploads). Leave blank to disable.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional Sentry. Empty values keep the monitoring stub in log-only mode.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
